<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="zeropos" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="database_file" Type="System.String" Scope="User">
      <Value Profile="(Default)" />
    </Setting>
    <Setting Name="shop_name" Type="System.String" Scope="User">
      <Value Profile="(Default)">ZEROPOS'SHOP</Value>
    </Setting>
    <Setting Name="shop_address" Type="System.String" Scope="User">
      <Value Profile="(Default)" />
    </Setting>
    <Setting Name="tax_id" Type="System.String" Scope="User">
      <Value Profile="(Default)" />
    </Setting>
    <Setting Name="bill_footer" Type="System.String" Scope="User">
      <Value Profile="(Default)">*เราได้บันทึกข้อมูลของคุณไว้แล้ว*ขอบคุณที่ใช้บริการ</Value>
    </Setting>
    <Setting Name="printer_name" Type="System.String" Scope="User">
      <Value Profile="(Default)" />
    </Setting>
    <Setting Name="auto_bill_print" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="vat" Type="System.Single" Scope="User">
      <Value Profile="(Default)">0</Value>
    </Setting>
    <Setting Name="shop_phone" Type="System.String" Scope="User">
      <Value Profile="(Default)">0123456789</Value>
    </Setting>
    <Setting Name="bill_prefix" Type="System.String" Scope="User">
      <Value Profile="(Default)">ZR</Value>
    </Setting>
    <Setting Name="logo_path" Type="System.String" Scope="User">
      <Value Profile="(Default)" />
    </Setting>
    <Setting Name="calculate_vat" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">False</Value>
    </Setting>
